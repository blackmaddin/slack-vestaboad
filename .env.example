# Vestaboard API credentials
VESTABOARD_API_KEY=replace_me
VESTABOARD_API_SECRET=replace_me
VESTABOARD_SUBSCRIPTION_ID=replace_me

# Slack app authentication
# Preferred: signing secret. If set, this is used for request verification.
SLACK_SIGNING_SECRET=replace_me
# Optional fallback if signing secret is not set.
SLACK_VERIFICATION_TOKEN=

# Web form settings
WEB_SECRET_PATH=replace_with_random_hex
WEB_FORM_TOKEN=replace_with_random_hex
WEB_FORM_TOKEN_REQUIRED=false

# Flask/session security
FLASK_SECRET_KEY=replace_with_random_hex

# App behavior
MAX_MESSAGE_LENGTH=200
RATE_LIMIT_STORAGE_URI=memory://
